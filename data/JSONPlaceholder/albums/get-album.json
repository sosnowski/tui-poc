  "presets": {
    ":default": {
      "pathParams": [
        {
          "key": "album_id",
          "value": "Something",
          "enabled": true
        },
        {
          "key": "owner_id",
          "value": "Owner ID",
          "enabled": true
        },
        {
          "key": "photo_slug",
          "value": "Slug of the photo",
          "enabled": true,
          "desc": "Id of the photo you want to see"
        }
      ],
      "params": [],
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "enabled": true
        },
        {
          "key": "Authorization",
          "value": "Bearer {{api_token}}",
          "enabled": true
        }
      ],
      "body": null,
      "bodyType": "none"
    }
  }
}
